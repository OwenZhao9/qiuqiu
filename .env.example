# 对话与视觉：DeepSeek，同一个 key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# 火山方舟（豆包），一个 key 通所有已开通模型。
# 模型 ID 带日期后缀，去掉后缀调不通；变更时用
#   curl https://ark.cn-beijing.volces.com/api/v3/models -H "Authorization: Bearer $VOLC_ARK_API_KEY"
# 查当前可用的。
VOLC_ARK_API_KEY=
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 生图：「让丘丘画一张」场景
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# 备选对话模型（默认仍走 DeepSeek 直连，切换时改 CHAT_PROVIDER）
DOUBAO_CHAT_MODEL=doubao-seed-2-1-pro-260628
# 角色扮演特化，人格层想更「有性格」时可换成它
DOUBAO_CHARACTER_MODEL=doubao-seed-character-260628

# 语音链路：cascade = VAD→ASR→Chat→TTS（本地为主）；realtime = 豆包端到端（需 VOLC_ARK_API_KEY）
VOICE_MODE=cascade
DOUBAO_REALTIME_MODEL=

# 语音：本地模型，不需要 key；这里只放路径
SENSEVOICE_MODEL_DIR=./models/weights/sensevoice
SILERO_VAD_PATH=./models/weights/silero_vad.onnx

# 语音合成：Azure 语音服务，官方接口，可用于产品。
# 和 Edge 朗读是同一批音色（zh-CN-XiaoxiaoNeural 本来就是 Azure 的音色名）。
# 拿法：Azure 门户建一个 Speech 资源，定价层选 F0（每月 50 万字符免费，长期有效），
# 在「密钥和终结点」页复制密钥与区域。
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# 存储
DATA_DIR=./data
