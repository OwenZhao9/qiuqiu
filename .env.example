# 对话与视觉：DeepSeek，同一个 key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp

# 火山方舟（豆包），一个 key 通所有已开通模型。
# 模型 ID 带日期后缀，去掉后缀调不通；变更时用
#   curl https://ark.cn-beijing.volces.com/api/v3/models -H "Authorization: Bearer $VOLC_ARK_API_KEY"
# 查当前可用的。
VOLC_ARK_API_KEY=
VOLC_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 生图：「让丘丘画一张」场景
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# 备选对话模型（默认仍走 DeepSeek 直连，切换时改 CHAT_PROVIDER）
DOUBAO_CHAT_MODEL=doubao-seed-2-1-pro-260628
# 角色扮演特化，人格层想更「有性格」时可换成它
DOUBAO_CHARACTER_MODEL=doubao-seed-character-260628

# 语音链路：cascade = VAD→ASR→Chat→TTS（本地为主）；realtime = 豆包端到端（需 VOLC_ARK_API_KEY）
VOICE_MODE=cascade
# 端到端实时语音。两条路线，音色与 model 必须配套：
#   O 路线   model=1.2.1.1  精品音色，人设走 dialog.system_role
#     zh_female_vv_jupiter_bigtts       活泼灵动女声（默认）
#     zh_female_xiaohe_jupiter_bigtts   甜美活泼女声，台湾口音
#     zh_male_yunzhou_jupiter_bigtts    清爽沉稳男声
#     zh_male_xiaotian_jupiter_bigtts   清爽磁性男声
#     en_male_tim_uranus_bigtts / en_female_dacey_uranus_bigtts / en_female_stokie_uranus_bigtts
#   SC 路线  model=2.2.0.0  角色扮演，21 个 saturn_ 克隆音色，人设走 dialog.character_manifest
#     saturn_zh_female_keainvsheng_tob   可爱女生
#     saturn_zh_female_nuanxinxuejie_tob 暖心学姐
#     saturn_zh_male_fengfashaonian_tob  风发少年   …（完整清单见接入文档）
# 适配器按 model 首位自动选人设字段，写错了不报错、只会安静地丢掉人格。
DOUBAO_REALTIME_MODEL=1.2.1.1
DOUBAO_REALTIME_SPEAKER=zh_female_vv_jupiter_bigtts

# 语音：本地模型，不需要 key；这里只放路径
SENSEVOICE_MODEL_DIR=./models/weights/sensevoice
SILERO_VAD_PATH=./models/weights/silero_vad.onnx

# 豆包语音（旧版控制台，APP ID + Access Token 鉴权，与方舟的 ark key 是两套）
# 应用 qiuqiu-desktop-pet，已开通：语音合成 2.0、流式识别 2.0、录音文件识别 2.0、端到端实时语音
VOLC_SPEECH_APPID=
VOLC_SPEECH_TOKEN=

# 存储
DATA_DIR=./data
